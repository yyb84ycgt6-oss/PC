# AI Studio Integration Configuration
#
# This is a Vite app. Client code reads `import.meta.env.VITE_*` — NOT
# `process.env`. Only VITE_-prefixed variables reach the browser.
#
# ⚠️  ANY VITE_ VARIABLE IS BAKED INTO THE PUBLIC BUNDLE.
#     This project already runs an Express server (server.ts) with a
#     /api/gemini/generate route — route through it and keep the key server-side.

# ====================================
# Recommended: proxy through server.ts
# ====================================
#   new GeminiBridge({ proxyUrl: import.meta.env.VITE_GEMINI_PROXY_URL, vision: true })
VITE_GEMINI_PROXY_URL=/api/gemini/generate
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_GEMINI_VISION=true
VITE_GEMINI_TEMPERATURE=0.7

# ====================================
# Server-side key (read by server.ts, never sent to the browser)
# ====================================
GEMINI_API_KEY=your_gemini_api_key_here

# ====================================
# Local model routing (server-side)
# ====================================
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# ====================================
# Integration behavior
# ====================================
VITE_MAX_HISTORY=50
